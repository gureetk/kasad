# Settings for kasad, one NAME=value to a line.
#
# contrib/kasad.service reads this as /etc/kasad.env, and contrib/compose.yaml
# as kasad.env beside it. It holds the password, so let only its owner read
# it:
#   chmod 600 kasad.env

# The plug's address. Tell the router to always give the plug the same one (a
# "DHCP reservation"), or this will stop being right.
KASAD_HOST=192.0.2.10

# Where to offer the web app and the JSON API. Left out, kasad offers neither.
# 127.0.0.1:8080 is for this machine only, and 0.0.0.0:8080 for every machine
# that can reach this one.
# In a container, leave this out: the image already listens on port 8080.
#KASAD_LISTEN=127.0.0.1:8080

# The password people sign in to the web app with. Set one whenever other
# machines can reach the address above.
#
# Write it as it is, without quotes. Letters, digits and spaces are read the
# same way by systemd and by Docker. Characters such as " ' $ # and \ are not,
# so a password with those is better kept in a file of its own, named by
# KASAD_PASSWORD_FILE.
#KASAD_PASSWORD=

# A token for programs that use the JSON API.
#KASAD_TOKEN=
