# Sample systemd unit for kasad.
#
# 1. Install the binary as /usr/local/bin/kasad.
# 2. Copy kasad.env.example to /etc/kasad.env and set KASAD_HOST in it to the
#    plug's address. To offer the web app and the JSON API as well, set
#    KASAD_LISTEN there, and KASAD_PASSWORD if other machines can reach it.
#    Then let only root read the file:
#      chown root:root /etc/kasad.env && chmod 600 /etc/kasad.env
# 3. Copy this file to /etc/systemd/system/kasad.service.
# 4. Run: systemctl daemon-reload && systemctl enable --now kasad
#
# The schedule can be made in the web app. To write it by hand instead, put
# it in /var/lib/kasad/schedule.json and run: systemctl restart kasad
#
# Logs go to the journal: journalctl -u kasad

[Unit]
Description=kasad smart plug scheduler
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=/etc/kasad.env
ExecStart=/usr/local/bin/kasad -data /var/lib/kasad serve
Restart=on-failure
RestartSec=5

# Run as a throwaway user whose only writable directory is /var/lib/kasad.
DynamicUser=yes
StateDirectory=kasad
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
